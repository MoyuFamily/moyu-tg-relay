# ==============================================================================
# moyu-tg-relay systemd environment configuration (/etc/moyu-tg-relay.env)
# ==============================================================================

# Core Relay Credentials
OTP_RELAY_BEARER_TOKEN=generate-a-secure-random-token-here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Telegram Account ID & Session path (populated after bootstrap_session)
TELEGRAM_ACCOUNT_ID=
TELEGRAM_SESSION_PATH=/var/lib/moyu-tg-relay/telegram.session

# Built-in Provider: Hax (Optional)
HAX_TELEGRAM_BOT=HaxTG_bot

# Observability & Log Retention (15 days default)
LOG_RETENTION_DAYS=15
RELAY_LOG_DB_PATH=/var/lib/moyu-tg-relay/relay_logs.db

# Multi-account mode: full list, overrides the legacy single-account settings.
# Each entry needs account_id and its own session_string or session_path.
# api_id/api_hash may inherit the global values or be specified per entry.
# Keep this entire value secret; use single quotes around the JSON in env files.
# TELEGRAM_ACCOUNTS_JSON='[
#   {
#     "account_id": "111111111",
#     "session_string": "<session-one>"
#   },
#   {
#     "account_id": "222222222",
#     "session_string": "<session-two>"
#   }
# ]'

