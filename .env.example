# ==============================================================================
# Moyu Telegram Interaction Relay Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Relay & Telegram Service Credentials
# ------------------------------------------------------------------------------
OTP_RELAY_BEARER_TOKEN=generate-a-secure-random-token-here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_ACCOUNT_ID=

# Preferred portable deployment mode (Telethon StringSession).
# Generate this locally via `python -m moyu_tg_relay.bootstrap_session`
# and store the value as a secret. Never commit a real StringSession.
TELEGRAM_SESSION_STRING=

# File-backed session fallback. Used only when TELEGRAM_SESSION_STRING is empty/unset.
TELEGRAM_SESSION_PATH=./.state/telegram.session

# Optional HTTP binding overrides (defaults: 127.0.0.1:8787)
# RELAY_HOST=127.0.0.1
# RELAY_PORT=8787

# ------------------------------------------------------------------------------
# 2. Built-in Provider: Hax (Optional Extension Settings)
# ------------------------------------------------------------------------------
HAX_TELEGRAM_BOT=HaxTG_bot

# Safe auto-confirm is enabled by default. The relay only attempts one explicitly
# allow-listed button when there is exactly one active request for the target provider
# and the sender plus message markers match its confirmation policy.
HAX_AUTO_CONFIRM=true
HAX_CONFIRMATION_SENDER_IDS=777000
HAX_CONFIRMATION_MARKERS=hax.co.id,hax
HAX_AUTO_CONFIRM_BUTTONS=confirm,approve,authorize,accept,yes,continue

# ------------------------------------------------------------------------------
# 3. Observability, Structured Logs & Admin Dashboard
# ------------------------------------------------------------------------------
# Log retention period in days (default: 15 days). Old logs are pruned automatically.
LOG_RETENTION_DAYS=15

# Filter out regular chat messages (groups, channels, and 1-on-1 human chats).
# When true (default), only bot messages and Telegram system notifications are listened to
# and recorded in activity logs, preventing excessive chat volume from filling logs.
FILTER_CHAT_MESSAGES=true

# Persistent SQLite database path for activity and audit logs (WAL mode)
# Default: directory of OTP_STORE_FILE / "relay_logs.db"
# RELAY_LOG_DB_PATH=./.state/relay_logs.db

# Multi-account mode: full list, overrides the legacy single-account settings.
# Each entry needs account_id and its own session_string or session_path.
# api_id/api_hash may inherit the global values or be specified per entry.
# Keep this entire value secret; use single quotes around the JSON in env files.
# TELEGRAM_ACCOUNTS_JSON='[
#   {
#     "account_id": "111111111",
#     "phone": "1234567890",
#     "api_id": 123456,
#     "api_hash": "0123456789abcdef0123456789abcdef",
#     "session_string": "<session-one>"
#   },
#   {
#     "account_id": "222222222",
#     "session_string": "<session-two>"
#   }
# ]'

