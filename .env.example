# moyu-tg-relay environment configuration
OTP_RELAY_BEARER_TOKEN=generate-a-secure-random-token-here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_ACCOUNT_ID=

# Preferred portable deployment mode. Generate this locally with
# `python -m moyu_tg_relay.bootstrap_session` and store the value as a secret.
# Never commit a real StringSession.
TELEGRAM_SESSION_STRING=

# Legacy file-backed session fallback. Used only when TELEGRAM_SESSION_STRING
# is empty/unset.
TELEGRAM_SESSION_PATH=./.state/hax-telegram.session

HAX_TELEGRAM_BOT=HaxTG_bot

# Safe auto-confirm is enabled by default. The relay only attempts one explicitly
# allow-listed button when there is exactly one active Hax request and the sender
# plus message markers match the Hax confirmation policy.
HAX_AUTO_CONFIRM=true
HAX_CONFIRMATION_SENDER_IDS=777000
HAX_CONFIRMATION_MARKERS=hax.co.id,hax
HAX_AUTO_CONFIRM_BUTTONS=confirm,approve,authorize,accept,yes,continue
